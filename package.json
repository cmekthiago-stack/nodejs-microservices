{
  "name": "nodejs-microservices",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "main": "index.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n auth,client -c cyan,magenta \"npm:dev:auth\" \"npm:dev:client\"",
    "dev:gateway": "npm run dev -w api-gateway",
    "dev:auth": "npm run dev -w auth-service",
    "db:migrate": "tsx scripts/db-migrate.ts"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "dotenv": "^18.0.7",
    "jsonwebtoken": "^9.0.3",
    "ws": "^8.22.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
